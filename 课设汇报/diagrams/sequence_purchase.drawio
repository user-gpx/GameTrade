        <!-- ==================== ACTIVATION BARS ==================== -->

        <!-- Main activation on View (buy_now handler) -->
        <mxCell id="a_view" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="334" y="105" width="12" height="630" as="geometry" />
        </mxCell>

        <!-- Activation on Item: step 2 select_for_update -->
        <mxCell id="a_item1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="569" y="185" width="12" height="50" as="geometry" />
        </mxCell>

        <!-- Activation on Item: step 6 stock deduction -->
        <mxCell id="a_item2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="569" y="485" width="12" height="50" as="geometry" />
        </mxCell>

        <!-- Activation on UserProfile: balance query + deduct + log -->
        <mxCell id="a_profile" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="764" y="315" width="12" height="150" as="geometry" />
        </mxCell>

