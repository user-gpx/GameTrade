  <diagram name="一键购买时序图" id="sequence_purchase">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 参与者 -->
        <mxCell id="p_buyer" value="买家" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p_view" value="buy_now 视图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="30" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p_item" value="Item / Order&#xa;模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="25" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_profile" value="UserProfile&#xa;模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="25" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- 生命线 -->
        <mxCell id="ll_b" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeWidth=1;strokeColor=#999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="85" y="70" as="sourcePoint"/><mxPoint x="85" y="500" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll_v" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeWidth=1;strokeColor=#999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="335" y="70" as="sourcePoint"/><mxPoint x="335" y="500" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll_i" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeWidth=1;strokeColor=#999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="570" y="75" as="sourcePoint"/><mxPoint x="570" y="500" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll_p" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeWidth=1;strokeColor=#999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="790" y="75" as="sourcePoint"/><mxPoint x="790" y="500" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- 事务边界 -->
        <mxCell id="tx" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e74c3c;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="230" y="140" width="660" height="310" as="geometry" />
        </mxCell>
        <mxCell id="tx_l" value="@transaction.atomic" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#e74c3c;align=right;" vertex="1" parent="1">
          <mxGeometry x="730" y="143" width="155" height="20" as="geometry" />
        </mxCell>

        <!-- 消息1: 点击购买 -->
        <mxCell id="m1" value="1. POST buy_now (item_id)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="110" as="sourcePoint"/>
            <mxPoint x="335" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 消息2: 查询校验道具 -->
        <mxCell id="m2" value="2. select_for_update 查询道具 (悲观锁)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1">
