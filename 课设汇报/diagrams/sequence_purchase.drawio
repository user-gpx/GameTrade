            <mxPoint x="570" y="375" as="sourcePoint"/>
            <mxPoint x="335" y="375" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 消息5: 返回结果 -->
        <mxCell id="m5" value="5. JsonResponse {ok, order_id, balance}" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335" y="430" as="sourcePoint"/>
            <mxPoint x="130" y="430" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 左侧注释 -->
        <mxCell id="note" value="&lt;b&gt;关键设计&lt;/b&gt;&#xa;• select_for_update&#xa;  悲观锁防超卖&#xa;• @transaction.atomic&#xa;  失败自动回滚" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="150" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
