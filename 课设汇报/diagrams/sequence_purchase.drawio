        </mxCell>

        <!-- 消息4: 创建订单+支付 -->
        <mxCell id="m4" value="4. 扣减库存 + 创建Order + 创建Payment" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
