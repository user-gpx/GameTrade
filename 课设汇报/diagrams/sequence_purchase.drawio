          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="90" y="75" as="sourcePoint" />
            <mxPoint x="90" y="850" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- View lifeline: center x=340 -->
        <mxCell id="ll_view" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 4;strokeWidth=1;strokeColor=#999999;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="340" y="75" as="sourcePoint" />
            <mxPoint x="340" y="850" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Item lifeline: center x=575 -->
