        <mxCell id="ll_profile" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 4;strokeWidth=1;strokeColor=#999999;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="770" y="75" as="sourcePoint" />
            <mxPoint x="770" y="850" as="targetPoint" />
          </mxGeometry>
