<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2024-06-11T00:00:00.000Z" agent="drawio" version="21.0.0">
  <diagram name="购买道具活动图" id="activity_purchase">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 泳道背景：买家 -->
        <mxCell id="lane1_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#BBDEFB;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1140" height="340" as="geometry" />
        </mxCell>
        <mxCell id="lane1_label" value="买家 (Buyer)" style="text;html=1;fontSize=14;fontStyle=1;fillColor=#2196F3;fontColor=#FFFFFF;align=center;rounded=1;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="140" height="30" as="geometry" />
        </mxCell>

        <!-- 泳道背景：系统 -->
        <mxCell id="lane2_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#C8E6C9;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="350" width="1140" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lane2_label" value="系统 (System)" style="text;html=1;fontSize=14;fontStyle=1;fillColor=#4CAF50;fontColor=#FFFFFF;align=center;rounded=1;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="20" y="350" width="140" height="30" as="geometry" />
        </mxCell>

        <!-- 泳道背景：卖家 -->
        <mxCell id="lane3_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFE0B2;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="650" width="1140" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lane3_label" value="卖家 (Seller)" style="text;html=1;fontSize=14;fontStyle=1;fillColor=#FF9800;fontColor=#FFFFFF;align=center;rounded=1;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="20" y="650" width="140" height="30" as="geometry" />
        </mxCell>

        <!-- 起点 -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- 买家活动节点 -->
        <mxCell id="act1" value="浏览道具列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act2" value="选择道具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act3" value="查看道具详情" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="160" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act4" value="点击购买按钮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="260" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- 判断节点1: 是否登录 -->
        <mxCell id="dec1" value="是否已登录?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="155" width="100" height="80" as="geometry" />
        </mxCell>

        <!-- 未登录分支 -->
        <mxCell id="act5" value="跳转登录页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="145" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act6" value="用户登录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="240" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- 判断节点2: 余额 -->
        <mxCell id="dec2" value="余额是否充足?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="280" width="100" height="80" as="geometry" />
        </mxCell>

        <!-- 余额不足 -->
        <mxCell id="act7" value="提示充值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="300" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- 确认收货 -->
        <mxCell id="act8" value="确认收货" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="260" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- 系统活动节点 -->
        <mxCell id="act9" value="创建订单&#xa;(锁定道具)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="460" width="120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="act10" value="扣减买家余额" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="460" width="120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="act11" value="处理支付" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="460" width="120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="act12" value="款项转入卖家余额" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="460" width="120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="act13" value="更新订单状态为完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="460" width="120" height="55" as="geometry" />
        </mxCell>

        <!-- 卖家活动 -->
        <mxCell id="act14" value="卖家发货" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE082;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="720" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- 终点 -->
        <mxCell id="end_inner" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1045" y="560" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end_outer" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1040" y="555" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- ===== 控制流边 ===== -->
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="start" target="act1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act1" target="act2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act2" target="act3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act3" target="act4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act4" target="dec1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- dec1 → dec2: 是(已登录) -->
        <mxCell id="c6" value="是(已登录)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;fontStyle=1;fillColor=#FFFFFF;fontColor=#2E7D32;" edge="1" parent="1" source="dec1" target="dec2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- dec1 → act5: 否(未登录) -->
        <mxCell id="c7" value="否(未登录)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;fontColor=#C62828;fillColor=#FFFFFF;" edge="1" parent="1" source="dec1" target="act5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act5" target="act6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- act6 → dec2: 登录后重新检查 -->
        <mxCell id="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act6" target="dec2"><mxGeometry relative="1" as="geometry">
          <Array as="points"><mxPoint x="730" y="265"/><mxPoint x="490" y="265"/></Array>
        </mxGeometry></mxCell>

        <!-- dec2 → act9: 是(余额充足) -->
        <mxCell id="c10" value="是(余额充足)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;fontStyle=1;fillColor=#FFFFFF;fontColor=#2E7D32;" edge="1" parent="1" source="dec2" target="act9"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- dec2 → act7: 否(余额不足) -->
        <mxCell id="c11" value="否(余额不足)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;fontColor=#C62828;fillColor=#FFFFFF;" edge="1" parent="1" source="dec2" target="act7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- act7 → dec2: 充值后返回 -->
        <mxCell id="c12" value="充值后重新判断" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;fillColor=#FFFFFF;" edge="1" parent="1" source="act7" target="dec2"><mxGeometry relative="1" as="geometry">
          <Array as="points"><mxPoint x="730" y="325"/><mxPoint x="490" y="340"/></Array>
        </mxGeometry></mxCell>

        <mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act9" target="act10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act10" target="act11"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 支付 → 卖家发货 -->
        <mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act11" target="act14"><mxGeometry relative="1" as="geometry">
          <Array as="points"><mxPoint x="680" y="540"/><mxPoint x="680" y="700"/></Array>
        </mxGeometry></mxCell>

        <!-- 卖家发货 → 买家确认收货 -->
        <mxCell id="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act14" target="act8"><mxGeometry relative="1" as="geometry">
          <Array as="points"><mxPoint x="680" y="770"/><mxPoint x="680" y="780"/><mxPoint x="870" y="780"/><mxPoint x="870" y="310"/></Array>
        </mxGeometry></mxCell>

        <!-- 确认收货 → 款项转入卖家余额 -->
        <mxCell id="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act8" target="act12"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="act12" target="act13"><mxGeometry relative="1" as="geometry"/></mxCell>

